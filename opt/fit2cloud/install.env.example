# =============================================================================
# Fit2Cloud 2.0 安装期配置（install.env）
# =============================================================================
#
# 本文件只放【安装期】变量：部署模式、安装路径、访问地址、集群拓扑、组件开关。
# 安装完成后一般不再修改。
#
# 运行期配置（中间件连接/密码、Nginx、性能、日志、备份等）见 runtime.env。
# 两个文件在安装时会被合并生成 <安装目录>/fit2cloud/.env，它是运行期唯一契约
# （f2cctl / 服务管理 / docker compose / 配置重渲染都只读 .env）。
#
# 使用：
#   cp install.env.example install.env
#   cp runtime.env.example runtime.env
#   bash install.sh            # 交互式安装
#   bash install.sh -s         # 静默安装（交互处自动取默认值）
# =============================================================================

# =============================================================================
# 部署模式
# =============================================================================

# standalone: 单机部署
# cluster: 集群部署（中间件节点 CE_CLUSTER_START_MW=true，其余节点自动外置中间件）
CE_MODE=standalone

# 安装路径
CE_INSTALL_PATH=/opt

# =============================================================================
# 访问配置
# =============================================================================

# 访问端口
CE_ACCESS_PORT=80

# 访问协议 (http/https)
CE_ACCESS_PROTOCOL=http

# 访问 IP（留空则自动检测本机 IP）
CE_ACCESS_IP=

# =============================================================================
# 集群配置（仅 CE_MODE=cluster 时生效）
# =============================================================================

# 当前节点 ID (每个节点不同: node1/node2/node3)
CE_CLUSTER_NODE_ID=

# 集群节点列表 (格式: node1:ip1,node2:ip2,node3:ip3)
CE_CLUSTER_NODES=

# 中间件节点 ID (默认: node1)
CE_CLUSTER_MIDWARE_NODE=node1

# 本节点是否启动中间件 (仅中间件节点为 true)
CE_CLUSTER_START_MW=true

# Eureka 集群地址（安装脚本按 CE_CLUSTER_NODES 自动生成，一般无需手填）
CE_EUREKA_SERVERS=
CE_MANAGEMENT_PORT=6602

# =============================================================================
# 启用模块
# =============================================================================

# 启用的 profiles (逗号分隔)
# standard: 标准模块 (management-center, gateway, dashboard, vm-service, etc.)
# extension: 扩展模块 (动态加载)
# all: 所有模块
# 不配置则启动所有模块
CE_PROFILES=

# =============================================================================
# 组件开关
# =============================================================================

# 是否使用外部中间件（true = 外部，连接参数在 runtime.env 中对应段落填写）
CE_EXTERNAL_MYSQL=false
CE_EXTERNAL_REDIS=false
CE_EXTERNAL_INFLUXDB=false
CE_EXTERNAL_KEYCLOAK=false
CE_EXTERNAL_RABBITMQ=false
CE_EXTERNAL_MINIO=false
CE_EXTERNAL_ANSIBLE=false

# 可选组件
# 安装 Nginx 反向代理 (true/false)
CE_INSTALL_NGINX=false
# 安装 Telegraf 监控 (true/false)
CE_INSTALL_TELEGRAF=true

# =============================================================================
# 安装行为
# =============================================================================

# 服务健康检查超时时间（秒，超时安装报错退出；服务启动慢可调大）
CE_HEALTHY_TIMEOUT=600

# Docker 网络名
CE_NETWORK_NAME=cmp-network
