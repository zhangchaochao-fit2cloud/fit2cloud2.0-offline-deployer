# =============================================================================
# Fit2Cloud 2.0 运行期配置（runtime.env）
# =============================================================================
#
# 本文件放【运行期】变量：中间件连接与密码、Nginx、安全、性能、日志、备份。
# 修改后需要重新渲染配置并重启服务：
#   f2cctl upgrade          （会重新渲染 conf）
#   或手动执行 bin/fit2cloud/standalone/ce-render-cfg 渲染后 restart
#
# 安装期变量（模式/路径/集群/组件开关）见 install.env，两者不要混放。
#
# 说明：
#   - 所有 CE_ 开头的变量都会被 ce-render-cfg 渲染到 fit2cloud.properties
#   - 带 "必填" 标注的变量在使用外部中间件时必须配置
# =============================================================================

# =============================================================================
# MySQL 配置
# =============================================================================

CE_MYSQL_DRIVER=com.mysql.cj.jdbc.Driver
CE_MYSQL_HOST=mysql
CE_MYSQL_PORT=3306
CE_MYSQL_DB=fit2cloud
CE_MYSQL_USER=root
# 密码为加密后值
CE_MYSQL_PASSWORD=U2FsdGVkX18JHB5ZNHZLFcHJT0XU7AxiNxC1FcV4tu+D8Bp2EswsCAqEMV4p58Lc
CE_MYSQL_PARAMS=autoReconnect=false&useUnicode=true&characterEncoding=UTF-8&characterSetResults=UTF-8&zeroDateTimeBehavior=CONVERT_TO_NULL&useSSL=false&nullCatalogMeansCurrent=true
CE_MYSQL_POOL_SIZE=20

# KeyCloak 数据库
CE_KEYCLOAK_DB=keycloak
CE_KEYCLOAK_PARAMS=autoReconnect=false&useUnicode=true&characterEncoding=UTF-8&characterSetResults=UTF-8&zeroDateTimeBehavior=CONVERT_TO_NULL&useSSL=false

# Activiti 数据库
CE_ACTIVITI_DB=activiti
CE_ACTIVITI_PARAMS=autoReconnect=false&useUnicode=true&characterEncoding=UTF-8&characterSetResults=UTF-8&zeroDateTimeBehavior=CONVERT_TO_NULL&useSSL=false

# =============================================================================
# Redis 配置
# =============================================================================

# Redis 模式 (single/cluster/sentinel)
CE_REDIS_MODE=single
CE_REDIS_HOST=redis
CE_REDIS_PORT=6379
# 密码为加密后值
CE_REDIS_PASSWORD=U2FsdGVkX18FExvjGK16G7Bu9tnwwjtgsx/BlVMPww/YjouBKeBkhSFzuADH3Vyd
CE_REDIS_DATABASE=0
CE_REDIS_MASTER=mymaster
CE_REDIS_POOL_SIZE=10

# =============================================================================
# InfluxDB 配置
# =============================================================================

CE_INFLUXDB_URL=http://influxdb:8086
CE_INFLUXDB_USER=fit2cloud
# 密码为加密后值
CE_INFLUXDB_PASSWORD=U2FsdGVkX18Au7ObDKEQdG05o3VEvYDPFrCsI1ZEsCB/dN4T8J8Bc3qdr61z8bhO
CE_INFLUXDB_DATABASE=fit2cloud
CE_INFLUXDB_LOG_DATABASE=log_fit2cloud

# =============================================================================
# KeyCloak 配置
# =============================================================================

CE_KEYCLOAK_URL=http://keycloak:8080/auth
# KeyCloak 管理员密码
CE_KEYCLOAK_PASSWORD=Password123@keycloak
# KeyCloak 端口（内置时生效）
CE_KEYCLOAK_PORT=8080
CE_KEYCLOAK_CLUSTER_PORT=7600

# =============================================================================
# RabbitMQ 配置
# =============================================================================

# MQ 模式 (single/cluster)
CE_RABBITMQ_MODE=single
CE_RABBITMQ_HOST=rabbitmq
CE_RABBITMQ_PORT=5672
CE_RABBITMQ_USER=fit2cloud
# 密码为加密后值
CE_RABBITMQ_PASSWORD=U2FsdGVkX19BmEFPkpUJa4knZvJtTdIbcw/JbPnhOts41JQBYxeP7JghLL9CI2nu

# =============================================================================
# Ansible 配置
# =============================================================================

CE_ANSIBLE_HOST=http://ansible:8000
CE_ANSIBLE_USER=root
# 密码为加密后值
CE_ANSIBLE_PASSWORD=U2FsdGVkX18lR+gfF3z0nHeV7F7yKwWDBep3f1CvlA0=
CE_ANSIBLE_DATABASE_TYPE=mysql
CE_ANSIBLE_DATABASE_HOST=mysql
CE_ANSIBLE_DATABASE_PORT=3306
CE_ANSIBLE_DATABASE_USER=root
CE_ANSIBLE_DATABASE_PASSWORD=U2FsdGVkX18JHB5ZNHZLFcHJT0XU7AxiNxC1FcV4tu+D8Bp2EswsCAqEMV4p58Lc
CE_ANSIBLE_REDIS_HOST=redis
CE_ANSIBLE_REDIS_PASSWORD=U2FsdGVkX18FExvjGK16G7Bu9tnwwjtgsx/BlVMPww/YjouBKeBkhSFzuADH3Vyd
CE_ANSIBLE_REDIS_PORT=6379

# =============================================================================
# MinIO 配置
# =============================================================================

# 以下在使用外部 MinIO 时必填（外部开关 CE_EXTERNAL_MINIO 在 install.env）
CE_MINIO_ENDPOINT=
CE_MINIO_ACCESS_KEY=
CE_MINIO_SECRET_KEY=
CE_MINIO_DEFAULT_BUCKET=

# 以下在使用内置 MinIO 时生效
CE_MINIO_API_PORT=9000
CE_MINIO_WEB_PORT=9001

# =============================================================================
# Nginx 配置
# =============================================================================

# HTTPS 配置
CE_NGINX_SSL=false
CE_NGINX_SSL_CERT=
CE_NGINX_SSL_KEY=
CE_NGINX_HTTP_TO_HTTPS=false

# 自动证书生成 (与手动证书二选一)
CE_NGINX_SSL_AUTO_GENERATE=false
# 证书类型: self-signed (自签名,开发测试) / letsencrypt (Let's Encrypt,生产环境)
CE_NGINX_SSL_AUTO_TYPE=self-signed
# Let's Encrypt 配置 (仅 ssl_auto_type=letsencrypt 时需要)
CE_NGINX_SSL_DOMAIN=
CE_NGINX_SSL_EMAIL=

# Gzip 压缩
CE_NGINX_GZIP=true
CE_NGINX_GZIP_TYPES="text/plain text/css application/json application/javascript text/xml application/xml"

# 静态资源缓存
CE_NGINX_STATIC_CACHE=true
CE_NGINX_STATIC_CACHE_DAYS=30

# 安全头
CE_NGINX_SECURITY_HEADERS=true

# 限流配置
CE_NGINX_RATE_LIMIT=false
CE_NGINX_RATE_LIMIT_RPS=10
CE_NGINX_RATE_LIMIT_BURST=20

# IP 黑白名单 (逗号分隔)
CE_NGINX_IP_ALLOW=
CE_NGINX_IP_DENY=

# 自定义配置文件路径
CE_NGINX_CUSTOM_CONF=

# =============================================================================
# 安全
# =============================================================================

CE_ADMIN_USERNAME=admin
CE_ADMIN_PASSWORD=Password123@cmp
CE_SECURITY_JWT_SECRET=change-me-in-production
CE_SECURITY_SESSION_TIMEOUT=3600
CE_SECURITY_PASSWORD=Password123@cmp

# =============================================================================
# 密码安全说明
# =============================================================================
#
# 密码字段支持以下格式:
#   1. 明文密码: 直接填写，安装时会自动加密存储
#   2. 加密密码: U2FsdGVkX1... 格式的加密值，直接使用
#
# 加密方式:
#   方式一: 使用 ce-render-cfg 加密 (推荐)
#     CE_ENCRYPTION_KEY=<your-key> bash install.sh
#
#   方式二: 使用 openssl 手动加密
#     echo -n "your-password" | openssl enc -aes-256-cbc -base64 -salt -pass pass:<your-key>
#
# 密码强度建议:
#   - 长度至少 8 位
#   - 包含大写字母、小写字母、数字和特殊字符
#   - 避免使用常见密码
#
# 安装时会自动检查密码强度并给出警告
# =============================================================================

# AES-GCM 加密密钥（32字节 base64 编码）
# 必须通过环境变量 CE_ENCRYPTION_KEY 传入，不要写在此文件
# 生成方式: openssl rand -base64 32
# 用法: CE_ENCRYPTION_KEY=<your-key> bash install.sh

# =============================================================================
# 性能
# =============================================================================

CE_JVM_HEAP_MIN=2g
CE_JVM_HEAP_MAX=4g

# =============================================================================
# 日志
# =============================================================================

CE_LOGGER_LEVEL=INFO
CE_LOGGER_RETENTION_DAYS=30
CE_LOGGER_MAX_CAPACITY_LIMIT=2
CE_LOGGER_LOG_LIMIT=50

# =============================================================================
# Docker
# =============================================================================

CE_DOCKER_DATA_ROOT=/opt/fit2cloud/docker
CE_DOCKER_LOG_MAX_SIZE=10m
CE_DOCKER_LOG_MAX_FILE=3

# =============================================================================
# 备份
# =============================================================================

CE_BACKUP_ENABLED=true
CE_BACKUP_DIR=/opt/fit2cloud/backup
CE_BACKUP_RETENTION_DAYS=7
CE_BACKUP_SCHEDULE=0 2 * * *
CE_BACKUP_MYSQL=true
CE_BACKUP_MINIO=true

# =============================================================================
# 日志管理
# =============================================================================

CE_LOG_ROTATE=true
CE_LOG_ROTATE_DAYS=30
CE_LOG_ROTATE_SIZE=100M
CE_LOG_COMPRESS=true
