#!/bin/bash
# chkconfig: 2345 10 90
# description: Fit2Cloud service
# Fit2Cloud 服务控制脚本：安装为 /etc/init.d/fit2cloud，同时被 systemd unit 以
# ExecStart/ExecStop/ExecReload 调用（start / stop / restart）
# compose 编排、健康检查、镜像备份等能力统一复用 scripts/ 下的库，不在本脚本重复实现

set -euo pipefail

export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIT2CLOUD_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

LIB_DIR="$FIT2CLOUD_DIR/scripts"
source "$LIB_DIR/common.sh"
source "$LIB_DIR/docker.sh"
source "$LIB_DIR/service.sh"
source "$LIB_DIR/os.sh"

ENV_FILE="$FIT2CLOUD_DIR/.env"
WORK_DIR="$(get_env_value CE_INSTALL_PATH "/opt" "$ENV_FILE")/fit2cloud"
LOG_DIR="$WORK_DIR/logs"

# 服务启动后的监测分钟数 / 停止超时秒数
WAIT_TIME=30
STOP_TIMEOUT=120

show_usage() {
    cat << 'EOF'

用法: fit2cloud <命令> [参数] [-w 分钟] [-t 秒]

服务管理:
  start [SERVICE]     启动服务
  stop [SERVICE]      停止服务
  restart [SERVICE]   重启服务
  recreate [SERVICE]  重新创建服务（按最新 compose 重建）
  status [SERVICE]    查看服务状态
  logs [SERVICE]      跟踪查看日志

维护:
  upgrade [increment|full|local [镜像路径]|SERVICE]   更新服务
  backup [FILTER]     备份服务镜像
  clean [image|log]   清理镜像/日志
  health              健康检查
  version             查看版本信息
  disk                磁盘使用情况

选项:
  -w, --wait-time MIN   启动后监测时长（分钟，默认 30）
  -t, --timeout SEC     停止超时（秒，默认 120）
EOF
}

# 手工解析：不用 getopt（外部 getopt 对未知选项整体失败会吞掉业务参数）
action=""
target=""
arg3=""
positionals=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -w|--wait-time)
            [[ $# -ge 2 ]] || die "缺少取值: $1"
            WAIT_TIME="$2"; shift 2 ;;
        --wait-time=*)
            WAIT_TIME="${1#*=}"; shift ;;
        -t|--timeout)
            [[ $# -ge 2 ]] || die "缺少取值: $1"
            STOP_TIMEOUT="$2"; shift 2 ;;
        --timeout=*)
            STOP_TIMEOUT="${1#*=}"; shift ;;
        -h|--help)
            show_usage; exit 0 ;;
        --)
            shift ;;
        *)
            positionals+=("$1"); shift ;;
    esac
done

action="${positionals[0]:-}"
target="${positionals[1]:-}"
arg3="${positionals[2]:-}"

# -----------------------------------------------------------------------------
# 生命周期
# -----------------------------------------------------------------------------

_start_named() {
    local name="$1"
    service_up "$WORK_DIR" "$ENV_FILE" "$name"
}

_stop_named() {
    local name="$1"
    service_stop "$WORK_DIR" "$ENV_FILE" "$name"
    _compose_run "$WORK_DIR" "$ENV_FILE" rm -f "$name" || true
}

start_service() {
    check_memory 16384

    if [[ -n "$target" ]]; then
        _start_named "$target"
    else
        service_up "$WORK_DIR" "$ENV_FILE" --no-recreate
    fi

    service_wait_ready "$WORK_DIR" "$ENV_FILE" "$WAIT_TIME"
}

stop_service() {
    local name="${1:-$target}"

    if [[ -n "$name" ]]; then
        _stop_named "$name"
    else
        _compose_run "$WORK_DIR" "$ENV_FILE" down -t "$STOP_TIMEOUT"
    fi
}

recreate_service() {
    check_memory 16384

    # 显式传参 = 仅重建这些服务；否则回落到 target，再否则全部
    local -a names=("$@")
    if [[ ${#names[@]} -eq 0 && -n "$target" ]]; then
        names=("$target")
    fi

    if [[ ${#names[@]} -gt 0 ]]; then
        service_up "$WORK_DIR" "$ENV_FILE" "${names[@]}"
    else
        service_up "$WORK_DIR" "$ENV_FILE"
    fi

    service_wait_ready "$WORK_DIR" "$ENV_FILE" "$WAIT_TIME"
}

restart_service() {
    if [[ -n "$target" ]]; then
        stop_service "$target"
        _start_named "$target"
    else
        stop_service
        service_up "$WORK_DIR" "$ENV_FILE" --no-recreate
    fi

    service_wait_ready "$WORK_DIR" "$ENV_FILE" "$WAIT_TIME"
}

status_service() {
    if [[ -n "$target" ]]; then
        _compose_run "$WORK_DIR" "$ENV_FILE" ps "$target"
    else
        service_status "$WORK_DIR" "$ENV_FILE"
    fi
}

logs_service() {
    if [[ -n "$target" ]]; then
        _compose_run "$WORK_DIR" "$ENV_FILE" logs -f "$target"
    else
        _compose_run "$WORK_DIR" "$ENV_FILE" logs -f
    fi
}

# -----------------------------------------------------------------------------
# 更新
# -----------------------------------------------------------------------------

# 镜像有变化的服务（增量更新用）：对比运行中容器的镜像 ID 与 pull 后的镜像 ID
_changed_services() {
    local modules
    modules=$(_compose_run "$WORK_DIR" "$ENV_FILE" config --format json 2>/dev/null \
        | jq -r '.services | to_entries[] | "\(.key) \(.value.container_name // "") \(.value.image // "")"')

    local service_name container image current_hash new_hash
    while IFS=' ' read -r service_name container image; do
        [[ -z "$service_name" ]] && continue
        current_hash=""
        if docker ps -a --format '{{.Names}}' | grep -q "^${container}$"; then
            current_hash=$(docker inspect "$container" --format '{{.Image}}' 2>/dev/null || true)
        fi
        new_hash=$(docker images "$image" --no-trunc --format '{{.ID}}' 2>/dev/null || true)

        if [[ -n "$new_hash" && "$current_hash" != "$new_hash" ]]; then
            echo "$service_name"
        fi
    done <<< "$modules"
}

_upgrade_increment() {
    cmd_exists jq || die "增量更新需要 jq，请先安装"

    _compose_run "$WORK_DIR" "$ENV_FILE" pull

    local -a changed=()
    local svc
    while IFS= read -r svc; do
        [[ -n "$svc" ]] && changed+=("$svc")
    done < <(_changed_services)

    if [[ ${#changed[@]} -eq 0 ]]; then
        log_info "所有服务已是最新版本"
        service_wait_ready "$WORK_DIR" "$ENV_FILE" "$WAIT_TIME"
        return 0
    fi

    log_info "需要更新的服务: ${changed[*]}"
    for svc in "${changed[@]}"; do
        stop_service "$svc"
    done
    recreate_service "${changed[@]}"
}

_upgrade_local() {
    local image_dir="${1:-$WORK_DIR/docker-images}"
    [[ -d "$image_dir" ]] || die "无效的镜像路径: $image_dir"

    log_info "加载本地镜像..."
    local image_file
    for image_file in "$image_dir"/*; do
        [[ -f "$image_file" ]] || continue
        log_info_inline "$(basename "$image_file")"
        docker load -qi "$image_file"
        log_ok
    done

    stop_service
    recreate_service
}

upgrade_service() {
    case "$target" in
        increment)
            _upgrade_increment
            ;;
        full|"")
            _compose_run "$WORK_DIR" "$ENV_FILE" pull
            stop_service
            recreate_service
            ;;
        local)
            _upgrade_local "$arg3"
            ;;
        *)
            _compose_run "$WORK_DIR" "$ENV_FILE" pull "$target"
            stop_service "$target"
            recreate_service "$target"
            ;;
    esac
}

# -----------------------------------------------------------------------------
# 维护与信息（实现见 scripts/service.sh，f2cctl 共用）
# -----------------------------------------------------------------------------

do_clean() {
    case "$target" in
        image)
            if [[ -t 0 ]]; then
                local answer
                read -rp "删除所有未使用的镜像? [y/N]: " answer
                [[ "$answer" == "y" || "$answer" == "yes" ]] || { log_info "操作已取消"; return 0; }
            fi
            service_clean_images
            ;;
        log)
            local choice
            [[ -t 0 ]] || die "非交互环境无法选择日志清理方式"
            echo "1) 删除所有日志"
            echo "2) 保留最近7天日志"
            read -rp "请选择 (1/2): " choice
            case "$choice" in
                1) service_clean_logs "$LOG_DIR" 0 ;;
                2) service_clean_logs "$LOG_DIR" 7 ;;
                *) log_info "操作已取消" ;;
            esac
            ;;
        *)
            do_clean image
            do_clean log
            ;;
    esac
}

main() {
    case "$action" in
        start)     start_service ;;
        stop)      stop_service ;;
        restart)   restart_service ;;
        recreate)  recreate_service ;;
        status)    status_service ;;
        logs)      logs_service ;;
        upgrade)   upgrade_service ;;
        backup)    service_backup_images "$WORK_DIR" "$ENV_FILE" "$WORK_DIR/backup/$(date "+%Y-%m-%d")" "$target" ;;
        clean)     do_clean ;;
        version)   service_version "$WORK_DIR" ;;
        health)    service_health "$WORK_DIR" "$ENV_FILE" ;;
        disk)      service_disk "$WORK_DIR" ;;
        *)
            show_usage
            [[ -z "$action" ]] || exit 1
            ;;
    esac
}

main
