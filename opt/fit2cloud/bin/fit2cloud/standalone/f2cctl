#!/bin/bash
# Fit2Cloud 2.0 运维管理命令（安装后由 install.sh/upgrade.sh 以 shim 方式暴露为 /usr/bin/f2cctl）
# 注意：本脚本按自身位置解析安装目录（SCRIPT_DIR/../../..），必须保留在
#       <安装目录>/bin/fit2cloud/standalone/ 下，不能直接拷贝到 /usr/bin

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIT2CLOUD_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
LIB_DIR="$FIT2CLOUD_DIR/scripts"

if [[ ! -d "$LIB_DIR" ]]; then
    echo "[ERROR] 未找到脚本目录 $LIB_DIR（f2cctl 必须安装在 <安装目录>/bin/fit2cloud/standalone 下）" >&2
    exit 1
fi

source "$LIB_DIR/common.sh"
source "$LIB_DIR/docker.sh"
source "$LIB_DIR/service.sh"
source "$LIB_DIR/extension.sh"

ENV_FILE="$FIT2CLOUD_DIR/.env"
WORK_DIR="$(get_env_value CE_INSTALL_PATH "/opt" "$ENV_FILE")/fit2cloud"
EXTENSION_DIR="$WORK_DIR/extensions"
LOG_DIR="$WORK_DIR/logs"

action="${1:-}"
target="${2:-}"

show_usage() {
    cat << 'EOF'
Fit2Cloud 控制工具

用法: f2cctl <命令> [参数]

服务管理:
  start [SERVICE]           启动服务（全部或指定服务）
  stop [SERVICE]            停止服务（全部为 down，指定服务为 stop）
  restart [SERVICE]         重启服务
  status                    查看服务状态
  logs [SERVICE] [LINES]    查看服务日志 (默认最近100行)
  health                    服务健康检查
  version                   查看版本信息
  disk                      查看磁盘使用情况

备份与还原:
  backup                    全量备份（配置/数据/扩展/日志/env + 镜像）
  restore <FILE>            从备份还原
  backup-image [FILTER]     仅备份 Docker 镜像（可按镜像名过滤）

升级与模块:
  upgrade <FILE>            升级 Fit2Cloud
  install-module <FILE>     安装/升级扩展模块（已安装则自动按升级处理）
  import <FILE>             导入产品包

系统:
  repo <ADDRESS>            配置 Docker 不安全仓库并登录
  clean [image|log]         清理镜像/日志 (默认: 全部)

EOF
}

# 校验 target 为已存在的文件
_require_target_file() {
    local usage="$1"
    [[ -n "$target" ]] || die "用法: f2cctl $usage"
    [[ -f "$target" ]] || die "文件不存在: $target"
}

# -----------------------------------------------------------------------------
# 服务管理
# -----------------------------------------------------------------------------

do_start() {
    local service_name="${1:-}"
    if [[ -n "$service_name" ]]; then
        service_up "$WORK_DIR" "$ENV_FILE" "$service_name"
    else
        service_up "$WORK_DIR" "$ENV_FILE"
    fi
}

do_stop() {
    local service_name="${1:-}"
    if [[ -n "$service_name" ]]; then
        log_info "停止服务: $service_name..."
        service_stop "$WORK_DIR" "$ENV_FILE" "$service_name"
        log_success "服务已停止: $service_name"
    else
        service_down "$WORK_DIR" "$ENV_FILE"
    fi
}

do_restart() {
    service_restart "$WORK_DIR" "$ENV_FILE" "${1:-}"
}

do_status() {
    service_status "$WORK_DIR" "$ENV_FILE"
}

do_logs() {
    service_logs "$WORK_DIR" "$ENV_FILE" "${1:-}" "${2:-100}"
}

do_health() {
    service_health "$WORK_DIR" "$ENV_FILE"
}

do_version() {
    service_version "$WORK_DIR"
}

do_disk() {
    service_disk "$WORK_DIR"
}

# -----------------------------------------------------------------------------
# 备份与还原
# -----------------------------------------------------------------------------

# 需要随配置一起留档的根级文件（还原后无需再手工准备 env）
_BACKUP_ENV_FILES=(".env" "install.env" "runtime.env")

do_backup() {
    local backup_time
    backup_time=$(date "+%Y-%m-%d-%H-%M-%S")
    local backup_dir="$WORK_DIR/backup_$backup_time"
    local docker_images_dir="$backup_dir/docker_images"

    ensure_dir "$docker_images_dir"

    log_info "停止服务以确保数据一致性..."
    service_down "$WORK_DIR" "$ENV_FILE" || true

    log_info "备份配置..."
    cp -rp "$WORK_DIR/conf" "$backup_dir/"

    log_info "备份数据..."
    cp -rp "$WORK_DIR/data" "$backup_dir/"

    local f
    for f in "${_BACKUP_ENV_FILES[@]}"; do
        if [[ -f "$WORK_DIR/$f" ]]; then
            cp -p "$WORK_DIR/$f" "$backup_dir/"
        fi
    done

    if [[ -d "$EXTENSION_DIR" ]]; then
        log_info "备份扩展..."
        cp -rp "$EXTENSION_DIR" "$backup_dir/"
    fi

    if [[ -d "$LOG_DIR" ]]; then
        log_info "备份日志..."
        cp -rp "$LOG_DIR" "$backup_dir/"
    fi

    if [[ -d "$WORK_DIR/external-compose" ]]; then
        log_info "备份 compose 编排..."
        cp -rp "$WORK_DIR/external-compose" "$backup_dir/"
    fi

    log_info "重新启动服务..."
    service_up "$WORK_DIR" "$ENV_FILE" || true

    service_backup_images "$WORK_DIR" "$ENV_FILE" "$docker_images_dir"

    log_info "打包备份..."
    local backup_file="$WORK_DIR/backup_$backup_time.tar"
    tar cf "$backup_file" -C "$WORK_DIR" "backup_$backup_time"
    gzip -f "$backup_file"

    rm -rf "$backup_dir"
    log_success "备份完成: ${backup_file}.gz"
}

do_restore() {
    _require_target_file "restore <FILE>"

    local tmp_dir
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/fit2cloud-restore.XXXXXX") || die "创建临时目录失败"

    log_info "停止服务..."
    service_down "$WORK_DIR" "$ENV_FILE" || true

    log_info "解压备份..."
    tar zxf "$target" -C "$tmp_dir"

    local backup_content
    backup_content=$(find "$tmp_dir" -maxdepth 1 -type d -name "backup_*" | head -1)
    if [[ -z "$backup_content" ]]; then
        rm -rf "$tmp_dir"
        die "备份文件格式不正确（未找到 backup_* 目录）"
    fi

    log_info "还原配置..."
    cp -rp "$backup_content/conf" "$WORK_DIR/"

    log_info "还原数据..."
    cp -rp "$backup_content/data" "$WORK_DIR/"

    local f
    for f in "${_BACKUP_ENV_FILES[@]}"; do
        if [[ -f "$backup_content/$f" ]]; then
            log_info "还原 $f..."
            cp -p "$backup_content/$f" "$WORK_DIR/"
        fi
    done

    if [[ -d "$backup_content/extensions" ]]; then
        log_info "还原扩展..."
        cp -rp "$backup_content/extensions" "$WORK_DIR/"
    fi

    if [[ -d "$backup_content/external-compose" ]]; then
        log_info "还原 compose 编排..."
        cp -rp "$backup_content/external-compose" "$WORK_DIR/"
    fi

    if [[ -d "$backup_content/logs" ]]; then
        log_info "还原日志..."
        cp -rp "$backup_content/logs" "$WORK_DIR/"
    fi

    if [[ -d "$backup_content/docker_images" ]]; then
        log_info "还原 Docker 镜像..."
        local image_file
        for image_file in "$backup_content/docker_images"/*.tar; do
            [[ -f "$image_file" ]] || continue
            log_info_inline "$(basename "$image_file")"
            docker load -qi "$image_file"
            log_ok
        done
    fi

    rm -rf "$tmp_dir"
    docker image prune -f >/dev/null 2>&1 || true

    log_info "启动服务..."
    service_up "$WORK_DIR" "$ENV_FILE"

    log_success "还原完成，可用 f2cctl health 检查服务状态"
}

do_backup_image() {
    local out_dir="$WORK_DIR/backup/$(date "+%Y-%m-%d")"
    service_backup_images "$WORK_DIR" "$ENV_FILE" "$out_dir" "$target"
}

# -----------------------------------------------------------------------------
# 升级与模块
# -----------------------------------------------------------------------------

do_upgrade() {
    _require_target_file "upgrade <FILE>"

    local tmp_dir
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/fit2cloud-upgrade.XXXXXX") || die "创建临时目录失败"

    log_info "解压升级包..."
    tar zxf "$target" -C "$tmp_dir"

    local upgrade_script
    upgrade_script=$(find "$tmp_dir" -maxdepth 4 -type f -name "upgrade.sh" | head -1)
    if [[ -z "$upgrade_script" ]]; then
        rm -rf "$tmp_dir"
        die "升级包中未找到 upgrade.sh"
    fi

    local rc=0
    bash "$upgrade_script" || rc=$?
    rm -rf "$tmp_dir"

    if [[ "$rc" -ne 0 ]]; then
        die "升级失败（退出码 $rc），可查看安装目录日志排查"
    fi
    log_success "升级完成"
}

do_install_module() {
    _require_target_file "install-module <FILE>"
    apply_extension auto "$target" "$WORK_DIR" "$ENV_FILE"
}

do_import() {
    _require_target_file "import <FILE>"

    log_info "导入产品包: $target"
    if ! curl -fS -X POST "http://localhost/vm-service/f2cctl/import" \
        -H "accept: */*" \
        -H "Content-Type: multipart/form-data" \
        -F "file=@${target};type=application/zip"; then
        echo
        die "导入失败，请确认服务已启动且产品包格式正确"
    fi
    echo
    log_success "产品包导入完成"
}

# -----------------------------------------------------------------------------
# 系统
# -----------------------------------------------------------------------------

# 向 daemon.json 的 insecure-registries 追加地址（优先 jq，无 jq 时用 sed 兜底）
_add_insecure_registry() {
    local daemon_file="$1"
    local repo="$2"
    local tmp
    tmp=$(mktemp) || return 1

    if cmd_exists jq; then
        if jq -e --arg repo "$repo" '."insecure-registries" | index($repo)' "$daemon_file" >/dev/null 2>&1; then
            rm -f "$tmp"
            return 0
        fi
        jq --arg repo "$repo" '."insecure-registries" = ((."insecure-registries" // []) + [$repo])' \
            "$daemon_file" > "$tmp"
    else
        if grep -q "\"$repo\"" "$daemon_file"; then
            rm -f "$tmp"
            return 0
        fi
        local escaped
        escaped=$(escape_sed_replacement "$repo")
        if grep -q '"insecure-registries"[[:space:]]*:[[:space:]]*\[\]' "$daemon_file"; then
            sed "s|\[\]|[\"${escaped}\"]|" "$daemon_file" > "$tmp"
        elif grep -q '"insecure-registries"' "$daemon_file"; then
            sed "s|\]|[\"${escaped}\"]|" "$daemon_file" > "$tmp"
        else
            sed "1s|{|{\"insecure-registries\":[\"${escaped}\"],|" "$daemon_file" > "$tmp"
        fi
    fi

    cat "$tmp" | sudo tee "$daemon_file" >/dev/null
    rm -f "$tmp"
}

_reload_docker() {
    if systemctl reload docker >/dev/null 2>&1; then
        return 0
    fi
    local pid
    pid=$(pidof dockerd 2>/dev/null || true)
    [[ -n "$pid" ]] && kill -HUP "$pid" 2>/dev/null || true
}

do_repo() {
    [[ -n "$target" ]] || die "用法: f2cctl repo <ADDRESS>"

    local daemon_file="/etc/docker/daemon.json"
    if [[ ! -f "$daemon_file" ]]; then
        ensure_dir "$(dirname "$daemon_file")"
        echo '{"insecure-registries":[]}' | sudo tee "$daemon_file" >/dev/null
    fi

    log_info "添加不安全仓库: $target"
    _add_insecure_registry "$daemon_file" "$target"

    log_info "重载 Docker 配置..."
    _reload_docker

    [[ -t 0 ]] || die "非交互环境无法输入仓库凭据，请手动执行: docker login $target"

    local username password
    read -rp "用户名: " username
    read -rsp "密码: " password
    echo

    # 密码走 stdin，避免出现在进程列表与 shell 历史中
    printf '%s' "$password" | docker login -u "$username" --password-stdin "$target"
    log_success "仓库配置完成: $target"
}

_confirm() {
    [[ -t 0 ]] || die "非交互环境，$(basename "$0") 的清理操作需要确认，请直接执行对应 docker 命令"
    local answer
    read -rp "$1 [y/N]: " answer
    [[ "$answer" == "y" || "$answer" == "yes" ]]
}

do_clean() {
    local clean_target="${1:-all}"

    case "$clean_target" in
        image)
            if _confirm "删除所有未使用的镜像?"; then
                service_clean_images
            else
                log_info "操作已取消"
            fi
            ;;
        log)
            echo "1) 删除所有日志"
            echo "2) 保留最近7天的日志"
            local choice
            read -rp "请选择 (1/2): " choice
            case "$choice" in
                1) service_clean_logs "$LOG_DIR" 0 ;;
                2) service_clean_logs "$LOG_DIR" 7 ;;
                *) log_info "操作已取消" ;;
            esac
            ;;
        all)
            do_clean image
            do_clean log
            ;;
        *)
            die "未知清理目标: $clean_target (可选: image, log, all)"
            ;;
    esac
}

main() {
    # 帮助类命令不依赖运行配置，未安装/未初始化时也能查看
    case "$action" in
        ""|help|-h|--help) show_usage; return 0 ;;
    esac

    [[ -f "$ENV_FILE" ]] || die "未找到运行配置 $ENV_FILE，请确认 Fit2Cloud 已安装"

    case "$action" in
        start)          do_start "$target" ;;
        stop)           do_stop "$target" ;;
        restart)        do_restart "$target" ;;
        status)         do_status ;;
        logs)           do_logs "$target" "${3:-100}" ;;
        health)         do_health ;;
        version)        do_version ;;
        disk)           do_disk ;;
        backup)         do_backup ;;
        backup-image)   do_backup_image ;;
        restore)        do_restore ;;
        upgrade)        do_upgrade ;;
        install-module) do_install_module ;;
        import)         do_import ;;
        repo)           do_repo ;;
        clean)          do_clean "${target:-all}" ;;
        ""|help|-h|--help) show_usage ;;
        *)
            log_error "未知命令: $action"
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
