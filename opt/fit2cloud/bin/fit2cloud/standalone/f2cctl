#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIT2CLOUD_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

LIB_DIR="$FIT2CLOUD_DIR/scripts"
source "$LIB_DIR/common.sh"
source "$LIB_DIR/docker.sh"
source "$LIB_DIR/service.sh"

ENV_FILE="$FIT2CLOUD_DIR/.env"
WORK_DIR=$(get_env_value CE_INSTALL_PATH "/opt" "$ENV_FILE")
WORK_DIR="$WORK_DIR/fit2cloud"
EXTENSION_DIR="$WORK_DIR/extensions"
LOG_DIR="$WORK_DIR/logs"

action="${1:-}"
target="${2:-}"

show_usage() {
    cat << EOF
Fit2Cloud 控制工具

用法: f2cctl <命令> [参数]

服务管理:
  start [SERVICE]           启动服务
  stop [SERVICE]            停止服务
  restart [SERVICE]         重启服务
  status                    查看服务状态
  logs [SERVICE] [LINES]    查看服务日志 (默认最近100行)

备份与还原:
  backup                    备份 Fit2Cloud
  restore <FILE>            从备份还原 Fit2Cloud
  backup-image              仅备份 Docker 镜像

升级与模块:
  upgrade <FILE>            升级 Fit2Cloud
  install-module <FILE>     安装/升级扩展模块
  import <FILE>             导入产品包

系统:
  repo <ADDRESS>            配置 Docker 不安全仓库
  clean [image|log]         清理镜像/日志 (默认: 全部)

EOF
}

do_start() {
    local service_name="${1:-}"
    if [[ -n "$service_name" ]]; then
        local compose_cmd
        compose_cmd=$(_get_compose_cmd "$WORK_DIR" "$ENV_FILE")
        $compose_cmd up -d "$service_name"
    else
        service_up "$WORK_DIR" "$ENV_FILE"
    fi
}

do_stop() {
    local service_name="${1:-}"
    if [[ -n "$service_name" ]]; then
        local compose_cmd
        compose_cmd=$(_get_compose_cmd "$WORK_DIR" "$ENV_FILE")
        $compose_cmd stop "$service_name"
    else
        service_down "$WORK_DIR" "$ENV_FILE"
    fi
}

do_restart() {
    local service_name="${1:-}"
    service_restart "$WORK_DIR" "$ENV_FILE" "$service_name"
}

do_status() {
    service_status "$WORK_DIR" "$ENV_FILE"
}

do_logs() {
    local service_name="${1:-}"
    local tail_lines="${2:-100}"
    service_logs "$WORK_DIR" "$ENV_FILE" "$service_name" "$tail_lines"
}

do_backup() {
    local backup_time=$(date "+%Y-%m-%d-%H-%M-%S")
    local backup_dir="$WORK_DIR/backup_$backup_time"
    local docker_images_dir="$backup_dir/docker_images"

    ensure_dir "$backup_dir"
    ensure_dir "$docker_images_dir"

    log_info "停止服务以确保数据一致性..."
    local compose_cmd
    compose_cmd=$(_get_compose_cmd "$WORK_DIR" "$ENV_FILE")
    $compose_cmd stop 2>/dev/null || true

    log_info "备份配置..."
    cp -rp "$WORK_DIR/conf" "$backup_dir/"

    log_info "备份数据..."
    cp -rp "$WORK_DIR/data" "$backup_dir/"

    if [[ -d "$EXTENSION_DIR" ]]; then
        log_info "备份扩展..."
        cp -rp "$EXTENSION_DIR" "$backup_dir/"
    fi

    if [[ -d "$LOG_DIR" ]]; then
        log_info "备份日志..."
        cp -rp "$LOG_DIR" "$backup_dir/"
    fi

    log_info "重新启动服务..."
    $compose_cmd start 2>/dev/null || true

    log_info "导出 Docker 镜像..."
    for image in $($compose_cmd config 2>/dev/null | grep "image:" | awk '{print $2}'); do
        local image_name=$(echo "$image" | awk -F'/' '{print $NF}' | tr ':' '_')
        log_info_inline "$image_name"
        docker save -o "$docker_images_dir/$image_name.tar" "$image"
        log_ok
    done

    log_info "备份 docker-compose..."
    local compose_dir="$WORK_DIR/external-compose"
    if [[ -d "$compose_dir" ]]; then
        cp -rp "$compose_dir" "$backup_dir/"
    fi

    log_info "打包备份..."
    tar zcf "$WORK_DIR/backup_$backup_time.tar" -C "$WORK_DIR" "backup_$backup_time"

    rm -rf "$backup_dir"
    log_success "备份完成: $WORK_DIR/backup_$backup_time.tar"
}

do_restore() {
    if [[ -z "$target" ]]; then
        log_error "用法: f2cctl restore <FILE>"
        exit 1
    fi

    if [[ ! -f "$target" ]]; then
        log_error "文件不存在: $target"
        exit 1
    fi

    local tmp_dir="/tmp/fit2cloud-restore/$(date +%s)"
    ensure_dir "$tmp_dir"

    log_info "停止服务..."
    do_stop

    log_info "解压备份..."
    tar zxf "$target" -C "$tmp_dir"

    local backup_content=$(ls -d "$tmp_dir"/backup_* 2>/dev/null | head -1)
    if [[ -z "$backup_content" ]]; then
        log_error "备份文件格式不正确"
        rm -rf "$tmp_dir"
        exit 1
    fi

    log_info "还原配置..."
    cp -rp "$backup_content/conf" "$WORK_DIR/"

    log_info "还原数据..."
    cp -rp "$backup_content/data" "$WORK_DIR/"

    if [[ -d "$backup_content/extensions" ]]; then
        log_info "还原扩展..."
        cp -rp "$backup_content/extensions" "$WORK_DIR/"
    fi

    if [[ -d "$backup_content/logs" ]]; then
        log_info "还原日志..."
        cp -rp "$backup_content/logs" "$WORK_DIR/"
    fi

    if [[ -d "$backup_content/docker_images" ]]; then
        log_info "还原 Docker 镜像..."
        for image_file in "$backup_content/docker_images"/*.tar; do
            [[ ! -f "$image_file" ]] && continue
            log_info_inline "$(basename "$image_file")"
            docker load -qi "$image_file"
            log_ok
        done
    fi

    rm -rf "$tmp_dir"
    docker image prune -f &>/dev/null || true

    log_info "启动服务..."
    do_start
    log_success "还原完成"
}

do_install_module() {
    if [[ -z "$target" ]]; then
        log_error "用法: f2cctl install-module <FILE>"
        exit 1
    fi

    if [[ ! -f "$target" ]]; then
        log_error "文件不存在: $target"
        exit 1
    fi

    local tmp_dir="/tmp/f2c-extensions/$(date +%s)"
    local extension_tmp_dir="$tmp_dir/extension"
    ensure_dir "$tmp_dir"

    log_info "解压模块..."
    tar zxf "$target" -C "$tmp_dir"

    local compose_file="$extension_tmp_dir/docker-compose.yml"
    if [[ ! -f "$compose_file" ]]; then
        log_error "模块缺少 docker-compose.yml"
        rm -rf "$tmp_dir"
        exit 1
    fi

    local image_address=$(get_env_value IMAGE_ADDRESS "registry.fit2cloud.com/north" "$ENV_FILE")
    sed -i "s#registry.fit2cloud.com/north#${image_address}#g" "$compose_file"

    local service_name=""
    local module_names=""
    for module_name in $(grep "container_name" "$compose_file" | awk -F "container_name: " '{print $NF}'); do
        module_names="$module_names $module_name"
        if [[ -z "$service_name" ]]; then
            service_name="$module_name"
        fi
    done

    local is_upgrade=false
    for name in $module_names; do
        if docker ps -a --format '{{.Names}}' | grep -q "^${name}$"; then
            is_upgrade=true
            break
        fi
    done

    local act="安装"
    if [[ "$is_upgrade" == "true" ]]; then
        act="升级"
    fi

    log_info "开始${act}模块: $service_name"

    for image_file in "$extension_tmp_dir"/*.tar; do
        [[ ! -f "$image_file" ]] && continue
        log_info_inline "加载镜像 $(basename "$image_file")"
        docker load -qi "$image_file"
        log_ok
    done

    local module_dir="$EXTENSION_DIR/$service_name"
    ensure_dir "$module_dir"

    if [[ -f "$module_dir/docker-compose.yml" ]]; then
        cp -f "$module_dir/docker-compose.yml" "$module_dir/docker-compose.yml.bak"

        if [[ "$is_upgrade" == "true" ]]; then
            log_info "停止原有服务..."
            local compose_exe
            compose_exe=$(get_docker_compose_exe "$ENV_FILE")
            $compose_exe -f "$WORK_DIR/external-compose/base-docker-compose.yml" \
                -f "$module_dir/docker-compose.yml" rm -sf $module_names 2>/dev/null || true
        fi
    fi

    cp -f "$compose_file" "$module_dir/"

    local ext_conf="$extension_tmp_dir/conf"
    local module_conf="$WORK_DIR/conf/$service_name"
    if [[ -d "$ext_conf" ]]; then
        ensure_dir "$module_conf"
        cp -rf "$ext_conf/"* "$module_conf/"
    fi

    local ext_script
    if [[ "$is_upgrade" == "true" ]]; then
        ext_script="$extension_tmp_dir/scripts/upgrade.sh"
    else
        ext_script="$extension_tmp_dir/scripts/install.sh"
    fi
    if [[ -f "$ext_script" ]]; then
        bash "$ext_script" --install_dir "$module_conf" --work_dir "$WORK_DIR"
    fi

    log_info "启动模块: $service_name..."
    local compose_args
    compose_args=$(get_compose_files "$WORK_DIR" "$ENV_FILE")
    if [[ -f "$module_dir/docker-compose.yml" ]]; then
        compose_args="$compose_args -f $module_dir/docker-compose.yml"
    fi
    local compose_exe
    compose_exe=$(get_docker_compose_exe "$ENV_FILE")
    $compose_exe $compose_args up --no-recreate -d $module_names

    rm -rf "$tmp_dir"
    log_success "模块${act}完成: $service_name"
}

do_upgrade() {
    if [[ -z "$target" ]]; then
        log_error "用法: f2cctl upgrade <FILE>"
        exit 1
    fi

    if [[ ! -f "$target" ]]; then
        log_error "文件不存在: $target"
        exit 1
    fi

    local tmp_dir="/tmp/fit2cloud-upgrade/$(date +%s)"
    ensure_dir "$tmp_dir"

    log_info "解压升级包..."
    tar zxf "$target" -C "$tmp_dir"

    local upgrade_script=$(find "$tmp_dir" -name "upgrade.sh" -type f | head -1)
    if [[ -n "$upgrade_script" ]]; then
        bash "$upgrade_script"
    else
        log_error "升级包中未找到 upgrade.sh"
    fi

    rm -rf "$tmp_dir"
    log_success "升级完成"
}

do_import() {
    if [[ -z "$target" ]]; then
        log_error "用法: f2cctl import <FILE>"
        exit 1
    fi

    if [[ ! -f "$target" ]]; then
        log_error "文件不存在: $target"
        exit 1
    fi

    log_info "导入产品包: $target"
    curl -X POST "http://localhost/vm-service/f2cctl/import" \
        -H "accept: */*" \
        -H "Content-Type: multipart/form-data" \
        -F "file=@$target;type=application/zip"
    echo
}

do_repo() {
    if [[ -z "$target" ]]; then
        log_error "用法: f2cctl repo <ADDRESS>"
        exit 1
    fi

    local daemon_file="/etc/docker/daemon.json"

    if [[ ! -f "$daemon_file" ]]; then
        ensure_dir "$(dirname "$daemon_file")"
        echo '{"insecure-registries":[]}' | sudo tee "$daemon_file" >/dev/null
    fi

    log_info "添加不安全仓库: $target"
    if cmd_exists jq; then
        if ! sudo jq -e --arg repo "$target" '."insecure-registries" | index($repo)' "$daemon_file" >/dev/null 2>&1; then
            local tmp_file=$(mktemp)
            sudo jq --arg repo "$target" '."insecure-registries" += [$repo]' "$daemon_file" > "$tmp_file" && sudo mv "$tmp_file" "$daemon_file"
        fi
    else
        if ! grep -q "\"$target\"" "$daemon_file"; then
            if grep -q '"insecure-registries":\[\]' "$daemon_file"; then
                sudo sed -i "s/\[\]/[\"$target\"]/" "$daemon_file"
            elif grep -q '"insecure-registries":\[.*\]' "$daemon_file"; then
                sudo sed -i "s/\]$/,\"$target\"]/" "$daemon_file"
            else
                sudo sed -i "1s/{/{\"insecure-registries\":[\"$target\"],/" "$daemon_file"
            fi
        fi
    fi

    log_info "重载 Docker 配置..."
    sudo kill -SIGHUP "$(pidof dockerd)" 2>/dev/null || true

    echo "请输入 Docker 仓库凭据:"
    local username password
    read -rp "用户名: " username
    read -rsp "密码: " password
    echo

    docker login -u "$username" -p "$password" "$target"
    log_success "仓库配置完成"
}

do_clean() {
    local clean_target="${1:-all}"

    case "$clean_target" in
        image)
            read -rp "删除所有未使用的镜像? (yes/no): " choice
            case "$choice" in
                yes) docker image prune -f; log_success "镜像已清理" ;;
                *) log_info "操作已取消" ;;
            esac
            ;;
        log)
            echo "1) 删除所有日志"
            echo "2) 保留最近7天的日志"
            read -rp "请选择 (1/2): " choice
            case "$choice" in
                1)
                    find "$LOG_DIR" -maxdepth 2 -type d -name "history" -exec rm -rf {} + 2>/dev/null || true
                    log_success "日志已清理"
                    ;;
                2)
                    find "$LOG_DIR" -maxdepth 2 -type d -name "history" 2>/dev/null | while read -r dir; do
                        find "$dir" -type f -name "*.log" -mtime +7 -delete 2>/dev/null || true
                    done
                    log_success "7天前的日志已清理"
                    ;;
                *) log_info "操作已取消" ;;
            esac
            ;;
        all)
            do_clean image
            do_clean log
            ;;
        *)
            log_error "未知清理目标: $clean_target (可选: image, log, all)"
            ;;
    esac
}

do_backup_image() {
    local backup_dir="$WORK_DIR/backup/$(date "+%Y-%m-%d")"
    ensure_dir "$backup_dir"

    local compose_cmd
    compose_cmd=$(_get_compose_cmd "$WORK_DIR" "$ENV_FILE")
    local image_names
    if [[ -n "$target" ]]; then
        image_names=$($compose_cmd config 2>/dev/null | grep "image:" | awk '{print $2}' | grep "$target")
    else
        image_names=$($compose_cmd config 2>/dev/null | grep "image:" | awk '{print $2}')
    fi

    log_info "备份 Docker 镜像..."
    for image_name in $image_names; do
        local name=$(echo "$image_name" | awk -F':' '{print $1}' | awk -F'/' '{print $3}')
        log_info_inline "$name"
        docker save -o "$backup_dir/${name}.tar" "$image_name"
        log_ok
    done

    log_success "镜像备份完成: $backup_dir"
}

main() {
    case "$action" in
        start)          do_start "$target" ;;
        stop)           do_stop "$target" ;;
        restart)        do_restart "$target" ;;
        status)         do_status ;;
        logs)           do_logs "$target" "${3:-100}" ;;
        backup)         do_backup ;;
        backup-image)   do_backup_image ;;
        restore)        do_restore ;;
        upgrade)        do_upgrade ;;
        install-module) do_install_module ;;
        import)         do_import ;;
        repo)           do_repo ;;
        clean)          do_clean "$target" ;;
        help)           show_usage ;;
        -h|--help)      show_usage ;;
        *)              show_usage; exit 1 ;;
    esac
}

main "$@"
