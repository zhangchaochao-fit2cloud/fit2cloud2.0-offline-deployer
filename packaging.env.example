# =============================================================================
# Fit2Cloud 2.0 打包时环境变量配置
# =============================================================================
#
# 此文件仅供 Jenkins/package.sh 打包时使用，不会打包进安装包。
# 安装时的用户配置见 opt/fit2cloud/install.env.example
#
# 使用方法：
#   1. cp packaging.env.example packaging.env
#   2. 在 Jenkins 中配置或直接编辑 packaging.env
#   3. bash package.sh --env-file packaging.env
#
# Jenkins 参数化构建示例：
#   bash package.sh --env-file packaging.env -v $GIT_TAG -b $BUILD_NUMBER
# =============================================================================

# =============================================================================
# 版本与构建（Jenkins 传入或手动填写）
# =============================================================================

FIT2CLOUD_VERSION=2.0
BUILD_NUMBER=1
# 镜像 tag（留空默认 = <版本号>.<构建号>；勿填 master 等开发标签）
VERSION=

# =============================================================================
# 镜像仓库
# =============================================================================

REGISTRY_URL=registry.fit2cloud.com/north
PLATFORM=amd64

# =============================================================================
# 工具下载地址（打包时从网络下载到安装包中，留空用脚本内置默认地址）
# =============================================================================

# Docker (x86_64)
DOCKER_PACKAGE_URL=https://download.docker.com/linux/static/stable/x86_64/docker-20.10.9.tgz

# Docker (aarch64)
DOCKER_PACKAGE_URL_ARM64=https://download.docker.com/linux/static/stable/aarch64/docker-20.10.9.tgz

# Docker RHEL8 兼容包
DOCKER_PACKAGE_URL_RHEL8=

# Telegraf RPM
TELEGRAF_PACKAGE_URL=

# MinIO 镜像（打包时 pull 并 save）
MINIO_DOCKER_IMAGE=registry.fit2cloud.com/north/minio:latest

# =============================================================================
# 插件、中间件、扩展（打包时从网络下载到安装包中）
# =============================================================================

# 插件包目录路径（逗号分隔）
PLUGIN_PACKAGES=

# 中间件部署包 URL（逗号分隔）
DEPLOYMENT_PACKAGES=

# 扩展包 URL（逗号分隔）
EXTENSION_PACKAGES=

# =============================================================================
# 输出
# =============================================================================

OUTPUT_DIR=./dist

# 从本地目录复制 Docker 工具包（不从网络下载）
FROM_DOCKER_LOCAL_DIR=
